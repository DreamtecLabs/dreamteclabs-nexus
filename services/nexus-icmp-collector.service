[Unit]
Description=DreamtecLabs Nexus ICMP OpenTelemetry Collector
After=network-online.target nexus-blackbox-exporter.service
Wants=network-online.target
Requires=nexus-blackbox-exporter.service

[Service]
Type=simple
ExecStart=/usr/bin/otelcol-contrib --config=/etc/proxmox-datacenter-manager/nexus-icmp-collector.yaml
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
