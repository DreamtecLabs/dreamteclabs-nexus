#!/usr/bin/env bash
set -euo pipefail

ENV_FILE="${NEXUS_DOMAINS_ENV_FILE:-/etc/proxmox-datacenter-manager/domains-hosting.env}"
if [[ -r "$ENV_FILE" ]]; then
    # shellcheck disable=SC1090
    source "$ENV_FILE"
fi

CF_API_BASE="${NEXUS_CF_API_BASE:-https://api.cloudflare.com/client/v4}"
HESTIA_SSH_HOST="${NEXUS_HESTIA_SSH_HOST:-root@192.168.0.29}"
CLOUDFLARE_SSH_HOST="${NEXUS_CLOUDFLARE_SSH_HOST:-root@192.168.0.36}"
DDNS_RECORDS_FILE="${NEXUS_DDNS_RECORDS_FILE:-/etc/cloudflare-ddns/records.conf}"
DDNS_SERVICE="${NEXUS_DDNS_SERVICE:-cloudflare-ddns.service}"
HESTIA_BIN="${NEXUS_HESTIA_BIN:-/usr/local/hestia/bin}"
MAIL_RELAY_HOST="${NEXUS_MAIL_RELAY_HOST:-smtp.dreamteclabs.com}"
MAIL_RELAY_IPV4="${NEXUS_MAIL_RELAY_IPV4:-23.254.215.34}"
WEBMAIL_HTTP_ORIGIN="${NEXUS_WEBMAIL_HTTP_ORIGIN:-http://192.168.0.29:80}"
WEBMAIL_HTTPS_ORIGIN="${NEXUS_WEBMAIL_HTTPS_ORIGIN:-https://192.168.0.29:443}"
DMARC_POLICY="${NEXUS_DMARC_POLICY:-p=none}"

require_cmd() {
    command -v "$1" >/dev/null 2>&1 || {
        echo "required command not found: $1" >&2
        exit 2
    }
}

for cmd in curl jq ssh dig; do
    require_cmd "$cmd"
done

validate_domain() {
    local domain="$1"
    [[ "$domain" =~ ^([a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,63}$ ]] || {
        echo "invalid domain: $domain" >&2
        exit 2
    }
}

cf_request() {
    local method="$1" path="$2" body="${3:-}"
    [[ -n "${NEXUS_CF_API_TOKEN:-}" ]] || {
        echo "NEXUS_CF_API_TOKEN is not configured" >&2
        exit 3
    }

    local args=(-fsS -X "$method" -H "Authorization: Bearer ${NEXUS_CF_API_TOKEN}" -H "Content-Type: application/json")
    if [[ -n "$body" ]]; then
        args+=(--data "$body")
    fi
    curl "${args[@]}" "${CF_API_BASE}${path}"
}

cf_zone_id() {
    local domain="$1" response
    response="$(cf_request GET "/zones?name=${domain}&status=active")"
    jq -er '.result[0].id' <<<"$response"
}

cf_upsert_dns() {
    local zone_id="$1" type="$2" name="$3" content="$4" proxied="$5" priority="${6:-}"
    local list record_id payload response
    list="$(cf_request GET "/zones/${zone_id}/dns_records?type=${type}&name=${name}")"
    record_id="$(jq -r '.result[0].id // empty' <<<"$list")"

    if [[ "$type" == "MX" ]]; then
        payload="$(jq -nc --arg type "$type" --arg name "$name" --arg content "$content" --argjson priority "${priority:-10}" '{type:$type,name:$name,content:$content,priority:$priority,ttl:1,proxied:false}')"
    else
        payload="$(jq -nc --arg type "$type" --arg name "$name" --arg content "$content" --argjson proxied "$proxied" '{type:$type,name:$name,content:$content,ttl:1,proxied:$proxied}')"
    fi

    if [[ -n "$record_id" ]]; then
        response="$(cf_request PUT "/zones/${zone_id}/dns_records/${record_id}" "$payload")"
    else
        response="$(cf_request POST "/zones/${zone_id}/dns_records" "$payload")"
    fi
    jq -e '.success == true' >/dev/null <<<"$response"
}

cf_upsert_tunnel_ingress() {
    local hostname="$1" service="$2" no_tls_verify="$3"
    local account_id="${NEXUS_CF_ACCOUNT_ID:-}" tunnel_id="${NEXUS_CF_TUNNEL_ID:-}"
    [[ -n "$account_id" && -n "$tunnel_id" ]] || {
        echo "NEXUS_CF_ACCOUNT_ID and NEXUS_CF_TUNNEL_ID are required" >&2
        exit 3
    }

    local response config updated body
    response="$(cf_request GET "/accounts/${account_id}/cfd_tunnel/${tunnel_id}/configurations")"
    config="$(jq -c '.result.config // {ingress:[{service:"http_status:404"}]}' <<<"$response")"

    updated="$(jq -c \
        --arg hostname "$hostname" \
        --arg service "$service" \
        --argjson no_tls_verify "$no_tls_verify" '
        .ingress = (
          ((.ingress // []) | map(select(.hostname != $hostname))) as $without
          | ($without | map(select(.hostname != null))) as $named
          | ($without | map(select(.hostname == null))) as $fallback
          | $named + [{hostname:$hostname,service:$service,originRequest:{noTLSVerify:$no_tls_verify}}] +
            (if ($fallback|length)>0 then $fallback else [{service:"http_status:404"}] end)
        )' <<<"$config")"
    body="$(jq -nc --argjson config "$updated" '{config:$config}')"
    response="$(cf_request PUT "/accounts/${account_id}/cfd_tunnel/${tunnel_id}/configurations" "$body")"
    jq -e '.success == true' >/dev/null <<<"$response"
}

ensure_ddns_record() {
    local zone="$1" record="$2" line="${zone}|${record}|false"
    ssh -o BatchMode=yes "$CLOUDFLARE_SSH_HOST" "set -eu; install -d -m 0755 \"\$(dirname '$DDNS_RECORDS_FILE')\"; touch '$DDNS_RECORDS_FILE'; grep -Fqx '$line' '$DDNS_RECORDS_FILE' || printf '%s\\n' '$line' >> '$DDNS_RECORDS_FILE'; systemctl start '$DDNS_SERVICE'"
}

hestia_has_mail_domain() {
    local user="$1" domain="$2"
    ssh -o BatchMode=yes "$HESTIA_SSH_HOST" "$HESTIA_BIN/v-list-mail-domain '$user' '$domain' json >/dev/null 2>&1"
}

hestia_ensure_mail_domain() {
    local user="$1" domain="$2"
    if ! hestia_has_mail_domain "$user" "$domain"; then
        ssh -o BatchMode=yes "$HESTIA_SSH_HOST" "$HESTIA_BIN/v-add-mail-domain '$user' '$domain'"
    fi
    ssh -o BatchMode=yes "$HESTIA_SSH_HOST" "$HESTIA_BIN/v-add-mail-domain-dkim '$user' '$domain' >/dev/null 2>&1 || true"
    ssh -o BatchMode=yes "$HESTIA_SSH_HOST" "$HESTIA_BIN/v-add-mail-domain-webmail '$user' '$domain' roundcube >/dev/null 2>&1 || true"
}

hestia_issue_mail_certificate() {
    local user="$1" domain="$2"
    ssh -o BatchMode=yes "$HESTIA_SSH_HOST" "$HESTIA_BIN/v-add-letsencrypt-domain '$user' '$domain' '' yes"
}

hestia_dkim_value() {
    local user="$1" domain="$2" output value
    output="$(ssh -o BatchMode=yes "$HESTIA_SSH_HOST" "$HESTIA_BIN/v-list-mail-domain-dkim-dns '$user' '$domain' plain")"
    value="$(awk '$1 == "mail._domainkey" {for (i=5;i<=NF;i++) printf "%s%s", $i, (i<NF?OFS:ORS)}' <<<"$output" | head -n1)"
    value="${value#\"}"
    value="${value%\"}"
    [[ "$value" == *"p="* ]] || {
        echo "unable to obtain DKIM public key from Hestia for $domain" >&2
        exit 4
    }
    printf '%s' "$value"
}

wait_for_mail_a() {
    local hostname="$1" attempt ip
    for attempt in {1..20}; do
        ip="$(dig +short A "$hostname" | head -n1)"
        if [[ "$ip" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
            printf '%s' "$ip"
            return 0
        fi
        sleep 3
    done
    echo "mail A record did not resolve for $hostname" >&2
    return 1
}

onboard() {
    local domain="$1" hestia_user="$2"
    validate_domain "$domain"

    local mail_host="mail.${domain}" webmail_host="webmail.${domain}" zone_id public_ip dkim_value
    local tunnel_target="${NEXUS_CF_TUNNEL_ID:-}.cfargotunnel.com"
    local steps='[]'

    ensure_ddns_record "$domain" "$mail_host"
    steps="$(jq -c '. + ["ddns:mail-record"]' <<<"$steps")"

    zone_id="$(cf_zone_id "$domain")"
    [[ -n "${NEXUS_CF_TUNNEL_ID:-}" ]] || { echo "NEXUS_CF_TUNNEL_ID is required" >&2; exit 3; }
    cf_upsert_dns "$zone_id" CNAME "$webmail_host" "$tunnel_target" true
    cf_upsert_tunnel_ingress "$webmail_host" "$WEBMAIL_HTTP_ORIGIN" false
    steps="$(jq -c '. + ["cloudflare:webmail-http"]' <<<"$steps")"

    hestia_ensure_mail_domain "$hestia_user" "$domain"
    steps="$(jq -c '. + ["hestia:mail-domain","hestia:dkim","hestia:roundcube"]' <<<"$steps")"

    public_ip="$(wait_for_mail_a "$mail_host")"
    hestia_issue_mail_certificate "$hestia_user" "$domain"
    steps="$(jq -c '. + ["hestia:letsencrypt"]' <<<"$steps")"

    cf_upsert_dns "$zone_id" A "$mail_host" "$public_ip" false
    cf_upsert_dns "$zone_id" MX "$domain" "$mail_host" false 10
    cf_upsert_dns "$zone_id" TXT "$domain" "v=spf1 a mx ip4:${public_ip} ip4:${MAIL_RELAY_IPV4} ~all" false

    dkim_value="$(hestia_dkim_value "$hestia_user" "$domain")"
    cf_upsert_dns "$zone_id" TXT "mail._domainkey.${domain}" "$dkim_value" false
    cf_upsert_dns "$zone_id" TXT "_dmarc.${domain}" "v=DMARC1; ${DMARC_POLICY}; rua=mailto:postmaster@${domain}; adkim=r; aspf=r" false
    steps="$(jq -c '. + ["cloudflare:mx","cloudflare:spf","cloudflare:dkim","cloudflare:dmarc"]' <<<"$steps")"

    cf_upsert_tunnel_ingress "$webmail_host" "$WEBMAIL_HTTPS_ORIGIN" true
    steps="$(jq -c '. + ["cloudflare:webmail-https"]' <<<"$steps")"

    jq -nc \
        --arg domain "$domain" \
        --arg mail_host "$mail_host" \
        --arg webmail_host "$webmail_host" \
        --arg relay "$MAIL_RELAY_HOST" \
        --argjson steps "$steps" \
        '{ok:true,domain:$domain,mail_host:$mail_host,webmail_host:$webmail_host,relay:$relay,steps:$steps}'
}

case "${1:-}" in
    onboard)
        [[ $# -eq 3 ]] || { echo "usage: $0 onboard DOMAIN HESTIA_USER" >&2; exit 2; }
        onboard "${2,,}" "$3"
        ;;
    *)
        echo "unsupported action: ${1:-}" >&2
        exit 2
        ;;
esac
