NEXUS_ENVIRONMENT=production
PDM_BASE_URL=https://127.0.0.1:8443
PDM_VERIFY_TLS=false
PDM_HEALTH_PATH=/api2/json/version
PDM_API_TOKEN_ID=
PDM_API_TOKEN_SECRET=
NEXUS_PROVIDER_TIMEOUT_SECONDS=5
NEXUS_POWER_OPERATIONS_ENABLED=false
NEXUS_POWER_VERIFY_ATTEMPTS=20
NEXUS_POWER_VERIFY_INTERVAL_SECONDS=1
NEXUS_PROVISIONING_ENABLED=false
NEXUS_PROVISIONING_VERIFY_ATTEMPTS=90
NEXUS_PROVISIONING_VERIFY_INTERVAL_SECONDS=1
NEXUS_OTEL_AGENT_VERSION=0.139.0
NEXUS_OTEL_AGENT_SCRIPT_PATH=/opt/dreamteclabs-nexus/services/nexus-otel-lxc-agent.sh
NEXUS_SSH_BOOTSTRAP_ATTEMPTS=30
NEXUS_SSH_BOOTSTRAP_INTERVAL_SECONDS=5
NEXUS_SSH_BOOTSTRAP_RUN_TIMEOUT_SECONDS=180
NEXUS_SIGNOZ_URL=http://192.168.0.47:8080
NEXUS_SIGNOZ_API_KEY=
SIGNOZ_OTLP_ENDPOINT=192.168.0.47:4317
NEXUS_DOMAINS_OPERATIONS_ENABLED=false
NEXUS_DOMAINS_HELPER_PATH=/opt/dreamteclabs-nexus/services/nexus-domains-helper
NEXUS_DOMAINS_HELPER_TIMEOUT_SECONDS=300
NEXUS_DOMAINS_VERIFY_ATTEMPTS=3
NEXUS_DOMAINS_VERIFY_INTERVAL_SECONDS=3
# Same credentials as NEXUS_CF_API_TOKEN/ACCOUNT_ID/TUNNEL_ID in
# /etc/proxmox-datacenter-manager/domains-hosting.env (used by nexus-domains-helper) --
# duplicated here because this process reads its own .env, not that one.
NEXUS_CF_API_BASE=https://api.cloudflare.com/client/v4
NEXUS_CF_API_TOKEN=
NEXUS_CF_ACCOUNT_ID=
NEXUS_CF_TUNNEL_ID=
